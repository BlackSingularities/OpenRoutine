{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRoutine",
  "version": "1.3.1",
  "identifier": "com.blacksingularities.openroutine",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenRoutine",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "redzikowski.com",
    "copyright": "© redzikowski.com",
    "homepage": "https://redzikowski.com",
    "category": "Utility",
    "shortDescription": "Automatyzacja Windows: zdarzenie → warunek → akcja",
    "longDescription": "OpenRoutine automatyzuje Windows: harmonogramy, aplikacje, pliki, zasilanie, sieć, skróty klawiszowe i integracje HTTP. Pomysł i wykonanie: redzikowski.com",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Polish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "customLanguageFiles": { "Polish": "nsis/Polish.nsh" },
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
